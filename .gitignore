# ── Go ──

# make build 的本地产物
/bin/
# make dist 的跨平台发布产物
/dist/
*.test
*.out

# ── 前端（web/，M4 才开始有）──
/web/node_modules/
/web/.vite/

# Frontend assets are generated before Go build, locally and in CI.
/internal/web/static/build/
/web/tsconfig.tsbuildinfo

# ── 本地开发 ──

# 手工测试用的库目录（kist init ./devlib）
/devlib/

# ── 编辑器 / 系统 ──
.DS_Store
.idea/
.vscode/
*.swp

# 本地 review 笔记，不进仓库
docs/review/

web/visual-results/

# Disposable source checkout and legacy visual images.
/.visual-baseline/
/web/visual/baselines/

# Local deployment settings may contain private addresses or credentials.
.env
.env.*
!.env.example
!.env.sample

# Python release tooling caches.
__pycache__/
*.py[cod]
